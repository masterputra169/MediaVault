[Unit]
Description=MediaVault Next.js frontend
After=network.target mediavault-backend.service

[Service]
Type=simple
WorkingDirectory=%h/mediavault/frontend
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/usr/bin/env node scripts/next.mjs start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true

[Install]
WantedBy=default.target
