BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
DATABASE_PATH=./storage/app.db
DOWNLOAD_DIR=./storage/downloads
TEMP_DIR=./storage/tmp
MAX_ACTIVE_DOWNLOADS=2
MAX_QUEUE_LENGTH=20
MAX_FILE_SIZE_MB=2048
METADATA_TIMEOUT_SECONDS=45
DOWNLOAD_TIMEOUT_SECONDS=3600
FFMPEG_PATH=
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000/api
# Single-user owner auth (required when PUBLIC_ORIGINS is enabled in FRONTEND_ORIGINS)
# Generate with: python scripts/set-owner-auth.py --username owner --generate
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SESSION_SECRET=
AUTH_SESSION_TTL_HOURS=168
